# Google AI Studio API Key for Gemma / Gemini models
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Gemma / Gemini model selection
# Recommended: gemma-4-26b-a4b-it, gemma-4-31b-it, gemini-flash-lite-latest, gemini-3.1-flash-lite-preview
GEMMA_MODEL=gemma-4-26b-a4b-it

# Google OAuth 2.0 Credentials (for 'Continue with Google' sign-in)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript origins: http://localhost:8000, http://127.0.0.1:8000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server host & port (optional)
HOST=0.0.0.0
PORT=8000
